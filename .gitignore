# ============================================================
# Raw, interim and processed datasets
# ============================================================

backend/data/raw/*
backend/data/interim/*
backend/data/processed/*

!backend/data/raw/.gitkeep
!backend/data/raw/absconding/
!backend/data/raw/absconding/.gitkeep
!backend/data/interim/.gitkeep
!backend/data/processed/.gitkeep


# ============================================================
# Shared split manifests
# Keep only the agreed common split manifest
# ============================================================

backend/data/manifests/*

!backend/data/manifests/.gitkeep
!backend/data/manifests/common_split_manifest.parquet


# ============================================================
# Prospective validation data
# Keep templates and data dictionaries, ignore collected records
# ============================================================

backend/data/prospective/*

!backend/data/prospective/.gitkeep
!backend/data/prospective/harvest_validation_template.csv
!backend/data/prospective/harvest_validation_data_dictionary.csv


